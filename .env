# ===== PostgreSQL on Neon Tech =====
# Replace these values with your actual Neon Tech credentials
# Format: postgresql://user:password@host:port/database?sslmode=require

SPRING_DATASOURCE_URL=postgresql://neon_user:password@ep-cool-sun-a12345.us-east-1.aws.neon.tech:5432/neon_db?sslmode=require
SPRING_DATASOURCE_USERNAME=neon_user
SPRING_DATASOURCE_PASSWORD=your_secure_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_DEFER_DATASOURCE_INITIALIZATION=true
SPRING_SQL_INIT_MODE=always

# ===== Application Configuration =====
SPRING_APPLICATION_NAME=backend
SERVER_PORT=8080

